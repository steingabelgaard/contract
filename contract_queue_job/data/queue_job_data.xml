<odoo>

	<record id="channel_subscription" model="queue.job.channel">
	    <field name="name">sub</field>
	    <field name="parent_id" ref="queue_job.channel_root" />
	</record>

	<record id="job_function__recurring_create_invoice" model="queue.job.function">
	    <field name="model_id" ref="contract.model_contract_contract" />
	    <field name="method">_recurring_create_invoice</field>
	    <field name="channel_id" ref="channel_subscription" />
	    <field name="retry_pattern" eval="{1: 60, 2: 180, 3: 10, 5: 300}" />
	</record>
	
</odoo>